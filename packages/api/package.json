{
  "name": "@inklusio/api",
  "version": "1.0.0",
  "description": "INKLUSIO API Server - Express + Prisma + Clean Architecture",
  "main": "src/app/server.ts",
  "scripts": {
    "dev": "nodemon --exec ts-node src/app/server.ts",
    "build": "tsc",
    "start": "node dist/app/server.js",
    "test": "jest --runInBand",
    "test:watch": "jest --watch --runInBand",
    "test:coverage": "jest --coverage --runInBand",
    "test:live": "LIVE_TEST=true jest --runInBand --testPathPattern=auth-live",
    "test:live:verbose": "LIVE_TEST=true jest --runInBand --testPathPattern=auth-live --verbose",
    "db:migrate": "prisma migrate dev --schema=../prisma/schema.prisma",
    "db:generate": "prisma generate --schema=../prisma/schema.prisma",
    "db:studio": "prisma studio --schema=../prisma/schema.prisma",
    "clean": "rm -rf dist node_modules",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "@prisma/client": "^5.7.0",
    "axios": "^1.13.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "express": "^4.19.2",
    "firebase": "^12.6.0",
    "firebase-admin": "^12.0.0",
    "helmet": "^7.0.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.12.8",
    "@types/supertest": "^2.0.15",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "prisma": "^5.7.0",
    "supertest": "^6.3.4",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.0"
  }
}
