// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../api/node_modules/@prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String   @id @default(uuid())
  firebaseUid     String   @unique // Firebase Authentication UID
  name            String?  // Display name from Firebase
  email           String?  // Email from Firebase (optional for some providers)
  phone           String?  // Phone number
  profileImage    String?  // Profile image URL
  
  // Onboarding fields
  onboardingStep              Int       @default(0)
  onboardingCompleted         Boolean   @default(false)
  gender                      String?
  dateOfBirth                 DateTime?
  description                 String?
  city                        String?
  federalState                String?
  latitude                    Float?
  longitude                   Float?
  allowLocation               Boolean   @default(false)
  interests                   String[]
  hobbies                     String[]
  accessibilityRequirements   String[]
  accessibilityTools          String[]
  lookingFor                  String[]
  communicationPreferences    String[]
  showAge                     Boolean   @default(false)
  allowMatching               Boolean   @default(true)
  publicProfile               Boolean   @default(true)
  allowNotifications          Boolean   @default(true)
  
  // Legacy fields (kept for backward compatibility)
  age             Int?     // Age
  location        Json?    // Location data (city, state, country, coordinates)
  accessibility   Json?    // Accessibility needs (screen reader, font size, etc.)
  preferences     Json?    // User preferences (language, notifications, etc.)
  
  // Feed preferences (separate from onboarding)
  feedPreferences Json?    // Feed-specific settings (interests, accessibility, distance, visibility)
  
  roles           Role[]   // User roles
  
  // Community relations
  feedPosts       FeedPost[]      // Posts created by user
  feedComments    FeedComment[]   // Comments created by user
  feedLikes       FeedLike[]      // Likes by user
  friendRequestsSent     FriendRequest[] @relation("FriendRequestSender")
  friendRequestsReceived FriendRequest[] @relation("FriendRequestReceiver")
  friendshipsInitiated   Friendship[]    @relation("FriendshipInitiator")
  friendshipsReceived    Friendship[]    @relation("FriendshipReceiver")
  conversationsCreated   Conversation[]  @relation("ConversationCreator")
  conversationParticipations ConversationParticipant[] @relation("ConversationParticipants")
  chatMessagesSent       ChatMessage[]   @relation("ChatMessageSender")
  messageReactions       MessageReaction[] @relation("MessageReactions")
  
  // Push notification tokens
  pushTokens      PushToken[]     // FCM tokens for push notifications
  
  // Notifications
  notificationsReceived Notification[] @relation("NotificationReceiver")
  notificationsTriggered Notification[] @relation("NotificationActor")
  
  // User blocking and reporting
  blockedUsers    BlockedUser[]   @relation("BlockerUser")
  blockedByUsers  BlockedUser[]   @relation("BlockedUser")
  reportsCreated  UserReport[]    @relation("ReporterUser")
  reportsReceived UserReport[]    @relation("ReportedUser")
  feedReports     FeedReport[]    @relation("FeedReporter")
  
  isDeleted       Boolean  @default(false) // Soft delete flag
  deletedAt       DateTime? // Deletion timestamp
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("users")
}

model Role {
  id        String   @id @default(uuid())
  name      String   // Role name (user, moderator, admin)
  userId    String   // Foreign key to User
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  
  @@unique([userId, name]) // Prevent duplicate roles per user
  @@map("roles")
}

// ============================================================================
// COMMUNITY MODULE MODELS
// ============================================================================

model FeedPost {
  id            String        @id @default(uuid())
  userId        String        // Author of the post
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  feedType      String        @default("photo") // Feed type: photo, location, review
  visibility    String        @default("public") // Visibility: public, friends, private
  content       String        @db.Text // Post content
  imageUrl      String?       // Optional image URL (backward compatibility)
  likesCount    Int           @default(0) // Denormalized count for performance
  commentsCount Int           @default(0) // Denormalized count for performance
  
  // Relations
  images        FeedImage[]   // Post images (max 5)
  comments      FeedComment[] // Comments on this post
  likes         FeedLike[]    // Likes on this post
  reports       FeedReport[]  // Reports on this post
  
  // Soft delete
  isDeleted     Boolean       @default(false)
  deletedAt     DateTime?
  
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  
  @@index([userId])
  @@index([feedType])
  @@index([visibility])
  @@index([createdAt])
  @@map("feed_posts")
}

model FeedImage {
  id          String    @id @default(uuid())
  postId      String    // Post this image belongs to
  post        FeedPost  @relation(fields: [postId], references: [id], onDelete: Cascade)
  s3Key       String    // S3 object key (e.g., "feeds/123456-image.jpg")
  filename    String    // Original filename
  mimeType    String    // MIME type (e.g., "image/jpeg")
  fileSize    Int       // File size in bytes
  width       Int?      // Image width in pixels
  height      Int?      // Image height in pixels
  order       Int       @default(0) // Display order (0-4 for max 5 images)
  status      String    @default("ready") // Status: ready, processing, failed
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  @@index([postId])
  @@index([order])
  @@map("feed_images")
}

model FeedComment {
  id        String    @id @default(uuid())
  postId    String    // Post this comment belongs to
  post      FeedPost  @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String    // Author of the comment
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String    @db.Text // Comment content
  
  // Soft delete
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  
  @@index([postId])
  @@index([userId])
  @@index([createdAt])
  @@map("feed_comments")
}

model FeedLike {
  id        String   @id @default(uuid())
  postId    String   // Post this like belongs to
  post      FeedPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String   // User who liked the post
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt DateTime @default(now())
  
  @@unique([postId, userId]) // One like per user per post
  @@index([postId])
  @@index([userId])
  @@map("feed_likes")
}

model FriendRequest {
  id         String    @id @default(uuid())
  senderId   String    // User who sent the friend request
  sender     User      @relation("FriendRequestSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId String    // User who received the friend request
  receiver   User      @relation("FriendRequestReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  status     String    @default("pending") // pending, accepted, rejected
  
  deletedAt  DateTime? // Soft delete timestamp
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  
  @@unique([senderId, receiverId]) // One request per user pair
  @@index([senderId])
  @@index([receiverId])
  @@index([status])
  @@map("friend_requests")
}

model Friendship {
  id         String    @id @default(uuid())
  userId     String    // First user in friendship
  user       User      @relation("FriendshipInitiator", fields: [userId], references: [id], onDelete: Cascade)
  friendId   String    // Second user in friendship
  friend     User      @relation("FriendshipReceiver", fields: [friendId], references: [id], onDelete: Cascade)
  status     String    @default("pending") // pending, accepted, rejected, blocked
  acceptedAt DateTime? // When friendship was accepted
  
  deletedAt  DateTime? // Soft delete timestamp
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  
  @@unique([userId, friendId]) // One friendship per user pair
  @@index([userId])
  @@index([friendId])
  @@index([status])
  @@map("friendships")
}

enum ConversationType {
  PRIVATE
  GROUP
}

model Conversation {
  id            String                    @id @default(uuid())
  type          ConversationType          @default(PRIVATE) // PRIVATE (1-to-1) or GROUP
  name          String?                   // Group name (required for GROUP, null for PRIVATE)
  lastMessageAt DateTime?                 // Last message timestamp for sorting
  createdById   String                    // User who initiated the conversation
  createdBy     User                      @relation("ConversationCreator", fields: [createdById], references: [id], onDelete: Cascade)
  
  // Many-to-many relation with users through join table
  participants  ConversationParticipant[]
  messages      ChatMessage[]             // Chat messages in this conversation
  
  // Soft delete and archive
  isDeleted     Boolean                   @default(false)
  deletedAt     DateTime?
  isArchived    Boolean                   @default(false) // Archive group conversations
  
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  
  @@index([createdAt])
  @@index([lastMessageAt])
  @@index([type])
  @@map("conversations")
}

enum ParticipantRole {
  ADMIN
  MEMBER
}

model ConversationParticipant {
  id             String          @id @default(uuid())
  conversationId String          // Conversation this participant belongs to
  conversation   Conversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String          // User who is a participant
  user           User            @relation("ConversationParticipants", fields: [userId], references: [id], onDelete: Cascade)
  role           ParticipantRole @default(MEMBER) // ADMIN or MEMBER (for groups)
  joinedAt       DateTime        @default(now()) // When user joined the conversation
  
  @@unique([conversationId, userId]) // One record per user per conversation
  @@index([conversationId])
  @@index([userId])
  @@index([role])
  @@map("conversation_participants")
}

// ============================================================================
// CHAT MESSAGES
// ============================================================================

enum MessageType {
  TEXT
  IMAGE
  AUDIO
}

model ChatMessage {
  id             String      @id @default(uuid())
  conversationId String      // Conversation this message belongs to
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String      // User who sent the message
  sender         User        @relation("ChatMessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  content        String?     @db.Text // Message content (nullable for media messages)
  type           MessageType @default(TEXT) // Message type: TEXT, IMAGE, AUDIO
  
  // Media support
  mediaUrl       String?     // URL to media file (S3/MinIO/DO Spaces)
  mediaType      String?     // MIME type (image/jpeg, audio/mp3, etc.)
  
  // Read receipts
  readAt         DateTime?   // When message was read
  
  // Reactions
  reactions      MessageReaction[]
  
  // Soft delete
  isDeleted      Boolean     @default(false)
  
  createdAt      DateTime    @default(now())
  
  @@index([conversationId, createdAt]) // For fetching messages in order
  @@index([senderId])
  @@index([type])
  @@map("chat_messages")
}

model MessageReaction {
  id        String      @id @default(uuid())
  messageId String      // Message being reacted to
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String      // User who reacted
  user      User        @relation("MessageReactions", fields: [userId], references: [id], onDelete: Cascade)
  emoji     String      // Emoji reaction (e.g., "👍", "❤️", "😂")
  createdAt DateTime    @default(now())
  
  @@unique([messageId, userId]) // One reaction per user per message
  @@index([messageId])
  @@index([userId])
  @@map("message_reactions")
}

// ============================================================================
// PUSH NOTIFICATION TOKENS
// ============================================================================

enum DeviceType {
  ANDROID
  IOS
  WEB
}

model PushToken {
  id         String     @id @default(uuid())
  userId     String     // User who owns this token
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  token      String     // FCM token from device
  deviceType DeviceType // Device platform
  deviceId   String?    // Optional device identifier
  isActive   Boolean    @default(true) // Active/inactive flag
  
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  deletedAt  DateTime?  // Soft delete timestamp
  
  @@unique([userId, token]) // Prevent duplicate tokens per user
  @@index([userId])
  @@index([isActive])
  @@index([deletedAt])
  @@map("push_tokens")
}

// ============================================================================
// USER BLOCKING & REPORTING
// ============================================================================

model BlockedUser {
  id        String   @id @default(uuid())
  blockerId String   // User who blocked
  blocker   User     @relation("BlockerUser", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String   // User who was blocked
  blocked   User     @relation("BlockedUser", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  
  @@unique([blockerId, blockedId]) // One block per user pair
  @@index([blockerId])
  @@index([blockedId])
  @@map("blocked_users")
}

enum ReportStatus {
  PENDING
  REVIEWED
  RESOLVED
}

model UserReport {
  id             String       @id @default(uuid())
  reporterId     String       // User who reported
  reporter       User         @relation("ReporterUser", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUserId String       // User being reported
  reportedUser   User         @relation("ReportedUser", fields: [reportedUserId], references: [id], onDelete: Cascade)
  reason         String       // Report reason
  description    String?      @db.Text // Optional detailed description
  status         ReportStatus @default(PENDING) // Report status
  createdAt      DateTime     @default(now())
  
  @@index([reporterId])
  @@index([reportedUserId])
  @@index([status])
  @@map("user_reports")
}

model FeedReport {
  id          String       @id @default(uuid())
  reporterId  String       // User who reported
  reporter    User         @relation("FeedReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  feedId      String       // Feed post being reported
  feed        FeedPost     @relation(fields: [feedId], references: [id], onDelete: Cascade)
  reason      String       // Report reason
  description String?      @db.Text // Optional detailed description
  status      ReportStatus @default(PENDING) // Report status
  createdAt   DateTime     @default(now())
  
  @@unique([reporterId, feedId]) // One report per user per feed
  @@index([feedId])
  @@index([reporterId])
  @@index([status])
  @@map("feed_reports")
}

// ============================================================================
// NOTIFICATIONS
// ============================================================================

enum NotificationType {
  LIKE
  COMMENT
  FRIEND_REQUEST
  MESSAGE
  FEED_REPORT
  SYSTEM
}

model Notification {
  id        String           @id @default(uuid())
  userId    String           // Notification receiver
  user      User             @relation("NotificationReceiver", fields: [userId], references: [id], onDelete: Cascade)
  actorId   String           // User who triggered the notification
  actor     User             @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Cascade)
  type      NotificationType // Type of notification
  entityId  String           // ID of related entity (post, comment, message, etc.)
  title     String           // Notification title
  body      String           @db.Text // Notification body
  isRead    Boolean          @default(false) // Read status
  createdAt DateTime         @default(now())
  
  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@map("notifications")
}
