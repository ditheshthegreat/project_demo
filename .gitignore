# ==========================================
# INKLUSIO Backend - .gitignore
# ==========================================

# ==========================================
# Dependencies
# ==========================================
node_modules/
jspm_packages/
bower_components/
.pnp
.pnp.js

# ==========================================
# Environment Variables
# ==========================================
.env
.env*.local
.env.development.local
.env.test.local
.env.production.local

# Keep example files
!.env.example
!.env.test.example

# ==========================================
# Build Outputs
# ==========================================
dist/
build/
out/
.next/
*.tsbuildinfo

# ==========================================
# Logs
# ==========================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# ==========================================
# Testing
# ==========================================
coverage/
*.lcov
.nyc_output/
test-results/
junit.xml

# ==========================================
# TypeScript
# ==========================================
*.tsbuildinfo
typings/

# ==========================================
# IDE & Editors
# ==========================================
# VS Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
*.swp
*.swo
*~

# Emacs
*~
\#*\#
.\#*

# ==========================================
# Operating System
# ==========================================
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msix
*.msm
*.msp
*.lnk

# Linux
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*

# ==========================================
# Database
# ==========================================
*.sqlite
*.sqlite3
*.db
*.db-shm
*.db-wal

# PostgreSQL
*.pgdata
*.pgsql

# Prisma
prisma/*.db
prisma/migrations/**/migration.sql.bak

# ==========================================
# Firebase
# ==========================================
# Keep Firebase service account keys private
*firebase*.json
!firebase.json

# Firebase cache
.firebase/
.firebaserc

# ==========================================
# Docker
# ==========================================
docker-compose.override.yml

# ==========================================
# Temporary Files
# ==========================================
*.tmp
*.temp
*.bak
*.swp
*.swo
*~
.cache/
.temp/
tmp/
temp/

# ==========================================
# Runtime & Process
# ==========================================
pids/
*.pid
*.seed
*.pid.lock

# ==========================================
# Package Manager
# ==========================================
# NPM
.npm
.npmrc
package-lock.json

# Yarn
.yarn-integrity
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.*
!.yarn/releases
!.yarn/plugins

# ==========================================
# Optional Caches
# ==========================================
.eslintcache
.stylelintcache
.node_repl_history
.parcel-cache

# ==========================================
# Misc
# ==========================================
*.tgz
*.zip
*.tar.gz
*.rar

# Diagnostic reports
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# ==========================================
# Project Specific
# ==========================================
# Documentation artifacts
ONBOARDING_*.md
TEST_*.md
SERVER_CRASH_FIX.md
JEST_CONFIG_FIXED.md
INTEGRATION_TEST_FIX_SUMMARY.md

# Test data
db.json
posts.json
user.json

# ==========================================
# Security
# ==========================================
# Never commit sensitive keys
*.pem
*.key
*.crt
*.p12
*.pfx
*.keystore
secrets/
.secrets/

